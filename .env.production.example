SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/mindoff
DB_USERNAME=mindoff_app
DB_PASSWORD=<secrets-manager-value>
AUTH_MODE=cognito
COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/<user-pool-id>
RECEIPT_OCR_MODE=textract
RECEIPT_S3_BUCKET=<private-receipt-bucket>
AWS_REGION=ap-northeast-2
APP_CORS_ALLOWED_ORIGINS=https://mindoff-project-preview.vercel.app

# Mobile build variables
EXPO_PUBLIC_API_URL=https://<api-domain>
EXPO_PUBLIC_AUTH_MODE=cognito
EXPO_PUBLIC_COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/<user-pool-id>
EXPO_PUBLIC_COGNITO_CLIENT_ID=<public-app-client-id>

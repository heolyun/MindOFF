{
  "name": "mindoff-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "expo": "~57.0.14",
    "expo-auth-session": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --clear --platform web --output-dir dist",
    "build:web:preview": "cross-env EXPO_PUBLIC_DEMO_MODE=true expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
